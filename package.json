{
  "name": "pandemetrix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pandemic predictive model application",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:ci": "jest --ci --coverage --watchAll=false --reporters=default --reporters=jest-junit",
    "test:unit": "jest --testPathPattern=tests/unit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --headless",
    "test:e2e": "cypress run --headless",
    "test:e2e:dev": "cypress open",
    "test:e2e:ci": "cypress run --headless --reporter junit --reporter-options mochaFile=cypress-results.xml",
    "test:all": "npm run test:ci && npm run test:e2e",
    "test:all:watch": "npm run test:watch & npm run test:e2e:dev",
    "test:coverage:open": "npm run test:coverage && open coverage/lcov-report/index.html",
    "lint": "eslint . --ext .js,.vue --fix",
    "lint:check": "eslint . --ext .js,.vue",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,scss,md}\"",
    "type-check": "tsc --noEmit",
    "build:analyze": "vite build --mode analyze",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "docker:dev": "docker-compose up -d",
    "docker:build": "docker build -t pandemetrix .",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "security:check": "npx better-npm-audit audit",
    "prepare": "husky install",
    "postinstall": "patch-package",
    "clean": "rimraf dist coverage cypress-results.xml junit.xml",
    "setup": "./scripts/ci-setup.sh",
    "build-check": "./scripts/build-check.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.12",
    "axios": "^1.9.0",
    "chart.js": "^4.4.9",
    "install": "^0.13.0",
    "tailwindcss": "^4.0.12",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.6",
    "@cypress/vite-dev-server": "^5.0.7",
    "@cypress/vue": "^6.0.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@testing-library/vue": "^7.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.3",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "bundlesize": "^0.18.1",
    "cypress": "^13.6.2",
    "cypress-axe": "^1.6.0",
    "cypress-real-events": "^1.14.0",
    "cypress-wait-until": "^3.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-vue": "^9.20.1",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.2.0",
    "patch-package": "^8.0.0",
    "plotly.js": "^3.0.1",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "vite": "^6.2.0",
    "vite-bundle-analyzer": "^0.7.0"
  },
  "bundlesize": [
    {
      "path": "dist/assets/*.js",
      "maxSize": "500kb"
    },
    {
      "path": "dist/assets/*.css",
      "maxSize": "50kb"
    }
  ],
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test:ci"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
